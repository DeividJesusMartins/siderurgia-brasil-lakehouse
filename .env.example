# Todas as variáveis têm valor padrão; ajuste só o que precisar.
# Para carregar no terminal (Linux/macOS):  set -a; source .env; set +a

# local | databricks (no Databricks é detectado automaticamente)
LAKEHOUSE_ENV=local
# Onde as tabelas Delta locais são gravadas
LAKEHOUSE_BASE_PATH=./lakehouse
# Catálogo do Unity Catalog (só no Databricks)
LAKEHOUSE_CATALOG=siderurgia_lakehouse_dev
# Início do histórico na primeira carga
DATA_INICIO=2015-01-01
# Janelas reprocessadas a cada carga incremental (as fontes revisam dados recentes)
SIDRA_ULTIMOS_MESES=24
COMEX_ANOS_REPROCESSAR=2
COMEX_ANOS_POR_CONSULTA=4
CLIMATE_TRACE_ANOS_REPROCESSAR=3
LOOKBACK_DIAS=45
