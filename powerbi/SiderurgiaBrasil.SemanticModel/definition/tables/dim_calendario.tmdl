table dim_calendario
	lineageTag: 6748ae39-aab0-4fd1-9a65-848dd4ab959a

	column mes_referencia
		dataType: dateTime
		formatString: mmm/yyyy
		lineageTag: 877b6432-40df-4202-925b-0708795149d2
