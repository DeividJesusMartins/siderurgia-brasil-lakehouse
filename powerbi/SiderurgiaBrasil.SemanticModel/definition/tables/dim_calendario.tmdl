	column nome_mes_es
		dataType: string
		lineageTag: 9d47c0fe-23fa-4101-b32b-9b09dd849c97
		summarizeBy: none
		sourceColumn: nome_mes_es
		sortByColumn: mes

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaDados & "dim_calendario.parquet")),
				    Tipos = Table.TransformColumnTypes(Fonte, {
				        {"mes_referencia", type date},
				        {"ano", Int64.Type},
				        {"mes", Int64.Type},
				        {"trimestre", Int64.Type},
				        {"semestre", Int64.Type},
				        {"ano_mes", type text},
				        {"nome_mes", type text}
				    }),
				    MesesEN = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"},
				    MesesES = {"Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"},
				    ComEN = Table.AddColumn(Tipos, "nome_mes_en", each MesesEN{[mes] - 1}, type text),
				    ComES = Table.AddColumn(ComEN, "nome_mes_es", each MesesES{[mes] - 1}, type text)
				in
				    ComES

	annotation PBI_ResultType = Table

