	column ano_mes
		dataType: string
		lineageTag: 9c32dba2-a15b-4331-bf85-e805dab3a5c2
		summarizeBy: none
		sourceColumn: ano_mes
		sortByColumn: mes_referencia

		annotation SummarizationSetBy = Automatic

	column nome_mes
		dataType: string
		lineageTag: 1f2c6763-f50e-4a1b-b38c-6b63ff0227a2
		summarizeBy: none
		sourceColumn: nome_mes
		sortByColumn: mes

		annotation SummarizationSetBy = Automatic

	column nome_mes_en
		dataType: string
		lineageTag: 908408e5-a89b-4f5d-bbc4-1c737017fcfe
		summarizeBy: none
		sourceColumn: nome_mes_en
		sortByColumn: mes

