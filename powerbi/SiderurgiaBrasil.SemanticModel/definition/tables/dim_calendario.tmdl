		formatString: 0
		lineageTag: f30333d4-1ae3-47cf-99e2-e905612d320d
		summarizeBy: none
		sourceColumn: ano

		annotation SummarizationSetBy = Automatic

	column mes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b644a9e3-a910-4741-ae55-926b3b2d487b
		summarizeBy: none
		sourceColumn: mes

		annotation SummarizationSetBy = Automatic

	column trimestre
