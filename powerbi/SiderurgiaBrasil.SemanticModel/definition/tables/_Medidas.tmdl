	measure 'Destaque Ranking (ícone)' =
			VAR _r = [Ranking no Ano]
			VAR _max = MAXX(ALLSELECTED(fato_emissoes_usina[usina_nome]), [Ranking no Ano])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_r), BLANK(),
			        _r <= 5, "🏆",
			        _r > _max - 5, "⚠️",
			        BLANK()
			    )
		displayFolder: 3 Emissões
		lineageTag: 4737de14-3f4d-430f-869e-37ed31554d98

	measure 'Destaque Ranking (cor)' =
			VAR _r = [Ranking no Ano]
			VAR _max = MAXX(ALLSELECTED(fato_emissoes_usina[usina_nome]), [Ranking no Ano])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_r), BLANK(),
			        _r <= 5, "#C92A2A",
			        _r > _max - 5, "#2F9E44",
			        BLANK()
			    )
		displayFolder: 3 Emissões
		lineageTag: 8eb0805f-18fc-44ab-9c1c-309f53ad803f

