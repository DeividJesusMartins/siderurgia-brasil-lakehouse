			        [Países de Destino],
			        REMOVEFILTERS(dim_calendario),
			        fato_exportacao_aco[mes_referencia] >= _ini,
			        fato_exportacao_aco[mes_referencia] <= _fim
			    )
		formatString: #,0
		displayFolder: 2 Exportações
		lineageTag: 3d51c631-f367-410e-917a-c49571ed9d56

	measure 'Concentração Top 5 Destinos 12m %' =
			VAR _ultimo = [Último Mês Exportação]
			VAR _ini = EDATE(_ultimo, -11)
			VAR _porPais =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(fato_exportacao_aco[pais]), "@volume", [Exportação (t)]),
			        REMOVEFILTERS(dim_calendario),
			        fato_exportacao_aco[mes_referencia] >= _ini,
			        fato_exportacao_aco[mes_referencia] <= _ultimo
			    )
			VAR _top5 = SUMX(TOPN(5, _porPais, [@volume], DESC), [@volume])
			RETURN
			    DIVIDE(_top5, SUMX(_porPais, [@volume]))
		formatString: 0.0%
		displayFolder: 2 Exportações
		lineageTag: e2207d0b-cb29-4efd-8650-936935854580

	measure 'Concentração Top 5 (texto)' = [Tradução - Texto Top 5 Destinos] & " = " & FORMAT([Concentração Top 5 Destinos 12m %], "0%", [Tradução - Cultura]) & " " & [Tradução - Texto Do Volume]
		displayFolder: 2 Exportações
		lineageTag: 2a3c95df-a719-4b92-ba6f-d338f3e85d68

	measure 'Referência Exportação (texto)' = [Tradução - Texto 12 Meses Até] & " " & FORMAT([Último Mês Exportação], "mmm/yyyy", [Tradução - Cultura])
		displayFolder: 2 Exportações
		lineageTag: 49f6ea61-736d-44fc-a678-023b7483684e

	measure 'Participação no Volume %' = DIVIDE([Exportação (t)], CALCULATE([Exportação (t)], ALLSELECTED(fato_exportacao_aco[pais])))
		formatString: 0.0%
		displayFolder: 2 Exportações
		lineageTag: a3d9c63c-3cfe-413b-ba68-67ae8ccaabe4

	measure 'Exportação Top 10 Destinos (mil t)' =
			IF(
			    ISINSCOPE(fato_exportacao_aco[pais])
			        && RANKX(ALLSELECTED(fato_exportacao_aco[pais]), [Exportação (mil t)], , DESC) <= 10,
			    [Exportação (mil t)]
			)
		formatString: #,0
		displayFolder: 2 Exportações
		lineageTag: 220935f3-970d-46d1-9241-e4365451a1ba

	measure 'Exportação Top 10 Produtos (mil t)' =
