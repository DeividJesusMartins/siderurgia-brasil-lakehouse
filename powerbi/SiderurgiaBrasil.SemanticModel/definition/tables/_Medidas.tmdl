	measure 'Emissões Totais do Setor (Mt CO2e)' = DIVIDE(SUM(painel_emissoes_anual[emissoes_total_t_co2e]), 1000000)
		formatString: #,0.00
		displayFolder: 3 Emissões
		lineageTag: 6fa5425b-6b08-48af-985b-54986a5197b8

	measure 'Indústria Geral (último mês)' =
			VAR _m = [Último Mês Produção]
			RETURN
			    CALCULATE([Índice Indústria Geral (dessaz.)], REMOVEFILTERS(dim_calendario), fato_producao_industrial[mes_referencia] = _m)
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: bdabfcf5-3106-4846-91cb-ea1ddfed2dbd

	measure 'Indústria Geral Var. 12m %' =
			VAR _m = [Último Mês Produção]
			RETURN
			    DIVIDE(
			        CALCULATE(AVERAGE(fato_producao_industrial[var_12m_pct]), REMOVEFILTERS(dim_calendario), fato_producao_industrial[mes_referencia] = _m, KEEPFILTERS(FILTER(ALL(dim_atividade[atividade_nome]), CONTAINSSTRING(dim_atividade[atividade_nome], "Indústria geral")))),
			        100
			    )
		formatString: 0.0%
		displayFolder: 1 Produção
		lineageTag: 4df33572-fefe-4f49-a459-ee4042922c31

	measure 'Indústria Geral Var. 12m (texto)' =
			VAR _v = [Indústria Geral Var. 12m %]
			RETURN
			    IF(
			        ISBLANK(_v),
			        [Tradução - Sem Base],
			        IF(_v >= 0, "▲ ", "▼ ") & FORMAT(ABS(_v), "0.0%", [Tradução - Cultura]) & " " & [Tradução - Sufixo Mesmo Mês]
			    )
		displayFolder: 1 Produção
		lineageTag: bf556abb-8a2e-4f17-995b-32793b0deada

	measure 'Atividades em Alta' =
			VAR _porAtividade =
			    ADDCOLUMNS(VALUES(dim_atividade[atividade_nome]), "@var", [Atividade Var. 12m % (último mês)])
			RETURN
			    COUNTROWS(FILTER(_porAtividade, [@var] > 0)) + 0
		formatString: #,0
		displayFolder: 1 Produção
		lineageTag: 262fcdf5-85da-49e6-b8ac-429bffbdb650

	measure 'Atividades em Alta (texto)' =
			VAR _porAtividade =
			    ADDCOLUMNS(VALUES(dim_atividade[atividade_nome]), "@var", [Atividade Var. 12m % (último mês)])
			RETURN
			    [Tradução - Texto De] & " " & COUNTROWS(FILTER(_porAtividade, NOT ISBLANK([@var]))) & " " & [Tradução - Texto Atividades Cresceram]
		displayFolder: 1 Produção
		lineageTag: a0f868cc-015c-4d50-aabf-66a76816f8d7

	measure 'Participação Maior Emissora %' =
			VAR _a = [Ano de Referência Emissões]
			RETURN
			    DIVIDE(CALCULATE(MAX(fato_emissoes_usina[participacao_pct]), fato_emissoes_usina[ano] = _a), 100)
		formatString: 0.0%
		displayFolder: 3 Emissões
		lineageTag: 069da5db-513e-467b-a69c-273196aea4e1

	measure 'Maior Emissora (nome)' =
