table _Medidas
	lineageTag: f7363723-152d-47ba-8719-08ff284e0e45

	measure 'Índice Metalurgia' = AVERAGE(painel_siderurgia_mensal[indice_metalurgia])
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: 49e169da-b39b-41e3-b93a-869cdc592145

	measure 'Índice Metalurgia (dessaz.)' = CALCULATE(AVERAGE(fato_producao_industrial[indice_sa]), KEEPFILTERS(FILTER(ALL(dim_atividade[atividade_nome]), CONTAINSSTRING(dim_atividade[atividade_nome], "Metalurgia"))))
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: cfbbcff9-3bfd-4ac5-befb-8fb3d5b125ee

	measure 'Índice Transformação (dessaz.)' = CALCULATE(AVERAGE(fato_producao_industrial[indice_sa]), KEEPFILTERS(FILTER(ALL(dim_atividade[atividade_nome]), CONTAINSSTRING(dim_atividade[atividade_nome], "transformação"))))
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: a9c6fbe7-9619-453a-99d6-408eb3e1b71d

	measure 'Índice Indústria Geral (dessaz.)' = CALCULATE(AVERAGE(fato_producao_industrial[indice_sa]), KEEPFILTERS(FILTER(ALL(dim_atividade[atividade_nome]), CONTAINSSTRING(dim_atividade[atividade_nome], "Indústria geral"))))
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: fbc2961d-0b9e-455d-8941-fa1d8b7d2a60

	measure 'Metalurgia Média Móvel 3m' = CALCULATE(AVERAGE(fato_producao_industrial[media_movel_3m_sa]), KEEPFILTERS(FILTER(ALL(dim_atividade[atividade_nome]), CONTAINSSTRING(dim_atividade[atividade_nome], "Metalurgia"))))
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: 98c35f85-34a6-4d32-b6fe-50542a63b98e

	measure 'Último Mês Produção' = CALCULATE(MAX(painel_siderurgia_mensal[mes_referencia]), NOT ISBLANK(painel_siderurgia_mensal[indice_metalurgia]))
		formatString: mmm/yyyy
		displayFolder: 1 Produção
		lineageTag: 7df2a82e-c16c-4c63-8383-da7caf448ee6

	measure 'Metalurgia (último mês)' =
			VAR _m = [Último Mês Produção]
			RETURN
			    CALCULATE([Índice Metalurgia (dessaz.)], REMOVEFILTERS(dim_calendario), fato_producao_industrial[mes_referencia] = _m)
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: c8d6d5c6-491d-47f6-8911-8634d7e084aa

	measure 'Transformação (último mês)' =
			VAR _m = [Último Mês Produção]
			RETURN
			    CALCULATE([Índice Transformação (dessaz.)], REMOVEFILTERS(dim_calendario), fato_producao_industrial[mes_referencia] = _m)
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: 25e64624-508c-4ff9-9291-1bd54d71eec5

	measure 'Metalurgia Var. 12m %' =
			VAR _m = [Último Mês Produção]
			RETURN
			    DIVIDE(
			        CALCULATE(AVERAGE(painel_siderurgia_mensal[metalurgia_var_12m_pct]), painel_siderurgia_mensal[mes_referencia] = _m),
			        100
			    )
		formatString: 0.0%
		displayFolder: 1 Produção
		lineageTag: 17a805dc-e5d5-4680-8b3a-76d36d006713

	measure 'Transformação Var. 12m %' =
			VAR _m = [Último Mês Produção]
			RETURN
			    DIVIDE(
			        CALCULATE(AVERAGE(fato_producao_industrial[var_12m_pct]), REMOVEFILTERS(dim_calendario), fato_producao_industrial[mes_referencia] = _m, KEEPFILTERS(FILTER(ALL(dim_atividade[atividade_nome]), CONTAINSSTRING(dim_atividade[atividade_nome], "transformação")))),
			        100
			    )
		formatString: 0.0%
		displayFolder: 1 Produção
		lineageTag: e4cfc1e8-38d4-4795-ba71-52ff2e25e977

	measure 'Metalurgia Var. 12m (texto)' =
			VAR _v = [Metalurgia Var. 12m %]
			RETURN
			    IF(
			        ISBLANK(_v),
			        [Tradução - Sem Base],
			        IF(_v >= 0, "▲ ", "▼ ") & FORMAT(ABS(_v), "0.0%", [Tradução - Cultura]) & " " & [Tradução - Sufixo Mesmo Mês]
			    )
		displayFolder: 1 Produção
		lineageTag: c874e082-b9d0-48df-ae08-84198d054148

	measure 'Transformação Var. 12m (texto)' =
			VAR _v = [Transformação Var. 12m %]
			RETURN
			    IF(
			        ISBLANK(_v),
			        [Tradução - Sem Base],
			        IF(_v >= 0, "▲ ", "▼ ") & FORMAT(ABS(_v), "0.0%", [Tradução - Cultura]) & " " & [Tradução - Sufixo Mesmo Mês]
			    )
		displayFolder: 1 Produção
		lineageTag: 5ffe14a4-a5d4-4ad4-b6e6-9f7cd6daa949

	measure 'Referência Produção (texto)' = [Tradução - Texto Índice Base] & " " & FORMAT([Último Mês Produção], "mmm/yyyy", [Tradução - Cultura])
		displayFolder: 1 Produção
		lineageTag: 2631c3c9-ef01-450a-a5ca-20cf621fc500

	measure 'Atividade Var. 12m % (último mês)' =
			VAR _m = [Último Mês Produção]
			RETURN
			    DIVIDE(
			        CALCULATE(AVERAGE(fato_producao_industrial[var_12m_pct]), REMOVEFILTERS(dim_calendario), fato_producao_industrial[mes_referencia] = _m),
			        100
			    )
		formatString: 0.0%
		displayFolder: 1 Produção
		lineageTag: dba7498f-e13a-456e-9042-d42b75b1d460

	measure 'Atividade Índice (último mês)' =
			VAR _m = [Último Mês Produção]
			RETURN
			    CALCULATE(AVERAGE(fato_producao_industrial[indice_sa]), REMOVEFILTERS(dim_calendario), fato_producao_industrial[mes_referencia] = _m)
		formatString: #,0.0
		displayFolder: 1 Produção
		lineageTag: 11bd996e-b70e-4772-8c27-485d2eb30840

	measure 'Exportação (t)' = SUM(fato_exportacao_aco[peso_t])
