	measure 'Usinas Monitoradas' =
			VAR _a = [Ano de Referência Emissões]
			RETURN
			    CALCULATE(DISTINCTCOUNT(fato_emissoes_usina[usina_id]), fato_emissoes_usina[ano] = _a)
		formatString: #,0
		displayFolder: 3 Emissões
		lineageTag: c239faba-bd2c-4cd7-bd66-ca2fa16a5016

	measure 'Ranking no Ano' =
			VAR _a = [Ano de Referência Emissões]
			RETURN
			    CALCULATE(MIN(fato_emissoes_usina[ranking_no_ano]), fato_emissoes_usina[ano] = _a)
		formatString: 0
		displayFolder: 3 Emissões
		lineageTag: b932c52f-7667-4b54-b91b-edde83c671d9

	measure 'Participação no Setor %' =
			DIVIDE(
			    [Emissões no Ano (Mt CO2e)],
			    CALCULATE([Emissões no Ano (Mt CO2e)], ALLSELECTED(fato_emissoes_usina[usina_nome]))
			)
		formatString: 0.0%
		displayFolder: 3 Emissões
		lineageTag: 7dd57641-1b5a-44ec-8683-05abcb72a602

	measure 'Concentração Top 3 Usinas %' =
			VAR _a = [Ano de Referência Emissões]
			RETURN
			    DIVIDE(
			        CALCULATE(SUM(fato_emissoes_usina[participacao_pct]), fato_emissoes_usina[ano] = _a, fato_emissoes_usina[ranking_no_ano] <= 3),
			        100
			    )
		formatString: 0.0%
		displayFolder: 3 Emissões
		lineageTag: 8c4b1381-859f-447c-a61d-878a3a065840

	measure 'Maior Emissora (texto)' =
			VAR _a = [Ano de Referência Emissões]
			RETURN
			    [Tradução - Texto Maior Emissora] & ": " & CALCULATE(MAX(painel_emissoes_anual[maior_emissora]), painel_emissoes_anual[ano] = _a)
