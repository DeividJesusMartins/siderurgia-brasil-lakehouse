	measure 'Último Mês Exportação' = MAX(fato_exportacao_aco[mes_referencia])
		formatString: mmm/yyyy
		displayFolder: 2 Exportações
		lineageTag: a83dfeb2-afc1-430b-8233-0609565817bc

	measure 'Exportação 12m (mil t)' =
			VAR _ultimo = [Último Mês Exportação]
			VAR _fim = EDATE(_ultimo, -0)
			VAR _ini = EDATE(_ultimo, -11)
			RETURN
			    CALCULATE(
			        [Exportação (mil t)],
			        REMOVEFILTERS(dim_calendario),
			        fato_exportacao_aco[mes_referencia] >= _ini,
			        fato_exportacao_aco[mes_referencia] <= _fim
			    )
		formatString: #,0
		displayFolder: 2 Exportações
		lineageTag: 5576f595-c9a1-4947-93fb-8e2f72f5e254

	measure 'Exportação 12m ant. (mil t)' =
			VAR _ultimo = [Último Mês Exportação]
			VAR _fim = EDATE(_ultimo, -12)
			VAR _ini = EDATE(_ultimo, -23)
			RETURN
			    CALCULATE(
			        [Exportação (mil t)],
			        REMOVEFILTERS(dim_calendario),
			        fato_exportacao_aco[mes_referencia] >= _ini,
			        fato_exportacao_aco[mes_referencia] <= _fim
			    )
		formatString: #,0
		displayFolder: 2 Exportações
		lineageTag: 1ee3be27-e6e4-4415-af0a-c99224953657

	measure 'Exportação Var. 12m %' =
			VAR _atual = [Exportação 12m (mil t)]
			VAR _anterior = [Exportação 12m ant. (mil t)]
			RETURN
			    IF(NOT ISBLANK(_anterior) && _anterior <> 0, DIVIDE(_atual, _anterior) - 1)
		formatString: 0.0%
		displayFolder: 2 Exportações
		lineageTag: 28282164-e21e-4583-9ef5-548235a13d75

